

# GymPilot n8n Environment Variables
# Copy to your n8n environment or configure directly in docker-compose / n8n env settings

# GymPilot Backend API
GYMPILOT_API_URL=https://api.gympilot.tn
GYMPILOT_ADMIN_EMAIL=admin@gympilot.tn
GYMPILOT_ADMIN_PASSWORD=your_gympilot_admin_password

# Apify Instagram Scraper (optional if passed via webhook, fallback)
APIFY_API_TOKEN=your_apify_api_token

# Google Gemini API Key (Gemini 2.0 Flash / 1.5 Flash)
GEMINI_API_KEY=your_gemini_api_key

# Instagram Graph API (Meta for Developers - to auto-post packs & products to Instagram Feed)
# Requirements:
# 1. Instagram Professional / Creator account connected to a Facebook Page.
# 2. Meta App with `instagram_basic`, `instagram_content_publish`, `pages_read_engagement`.
# 3. Never-expiring or long-lived Page Access Token.
INSTAGRAM_ACCOUNT_ID=17841430839324619
INSTAGRAM_ACCESS_TOKEN=your_meta_page_or_instagram_user_access_token

# Webhook Security
N8N_WEBHOOK_SECRET=your_optional_webhook_secret
